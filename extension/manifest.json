{
  "manifest_version": 3,
  "name": "Downy",
  "version": "2.0.0",
  "description": "Adds a Download this video button over YouTube videos. Needs the Downy desktop app running on this PC.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_popup": "popup.html", "default_title": "Downy" },
  "background": { "service_worker": "background.js" },
  "host_permissions": ["http://127.0.0.1:9614/*"],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
