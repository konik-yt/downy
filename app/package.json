{
  "name": "downy",
  "productName": "Downy",
  "version": "2.2.1",
  "description": "Downy download manager for YouTube videos",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable",
    "dist:dir": "electron-builder --win --dir"
  },
  "build": {
    "appId": "dev.downy.app",
    "productName": "Downy",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "icon": "src/renderer/assets/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Downy",
      "artifactName": "Downy-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Downy-${version}-portable.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "konik-yt",
        "repo": "downy"
      }
    ],
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "dist"
    },
    "protocols": [
      {
        "name": "Downy",
        "schemes": [
          "downy"
        ]
      }
    ],
    "extraResources": [
      {
        "from": "../extension",
        "to": "extension"
      }
    ]
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "electron": "^38.8.6",
    "electron-builder": "^26.18.0"
  }
}
