{
  "name": "downy",
  "productName": "Downy",
  "version": "2.0.0",
  "description": "Downy download manager for YouTube videos",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable nsis"
  },
  "build": {
    "appId": "dev.downy.app",
    "productName": "Downy",
    "files": [
      "src/**/*",
      "node_modules/@fontsource-variable/inter/**/*",
      "package.json"
    ],
    "win": {
      "icon": "src/renderer/assets/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Downy-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Downy-${version}-portable.exe"
    }
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0"
  },
  "devDependencies": {
    "electron": "^38.8.6",
    "electron-builder": "^26.18.0"
  }
}
